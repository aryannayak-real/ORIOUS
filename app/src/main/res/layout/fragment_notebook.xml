<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/notebook_controls_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/notebook_filter_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:checkedChip="@+id/notebook_chip_all"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/notebook_chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/note_filter_all"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="10dp"
                app:chipStrokeColor="?attr/colorOutlineVariant"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notebook_chip_favorites"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/note_filter_favorites"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="10dp"
                app:chipIcon="@drawable/ic_outline_star_24"
                app:chipIconSize="16dp"
                app:chipIconTint="?attr/colorFavorite"
                app:chipStrokeColor="?attr/colorOutlineVariant"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/notebook_count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:textColor="?attr/colorOnSurfaceDim"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="88dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/notebook_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notebook_empty_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.85"
            android:contentDescription="@null"
            android:src="@drawable/ic_outline_description_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/notebook_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="18dp"
            android:text="@string/note_empty_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/notebook_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxWidth="320dp"
            android:paddingTop="10dp"
            android:text="@string/note_empty_message"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notebook_empty_cta"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/note_empty_cta" />

    </LinearLayout>

</LinearLayout>
