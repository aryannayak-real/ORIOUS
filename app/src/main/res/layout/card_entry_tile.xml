<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true"
    android:elevation="0dp"
    style="@style/Widget.Aegis.EntryCardView"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp"
    app:checkedIcon="@null" app:cardCornerRadius="0dp">

    <LinearLayout
        android:id="@+id/rlCardEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/favorite_indicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/favorite_indicator"
            android:backgroundTint="?attr/colorFavorite" />

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <RelativeLayout
                android:id="@+id/layoutImage"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivTextDrawable"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Aegis.ImageView.Circle" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivSelected"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:background="?attr/colorPrimaryAlternative"
                    android:src="@drawable/item_selected"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Aegis.ImageView.Circle" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/layoutImage"
                android:layout_marginStart="8dp" android:layout_below="@id/profile_codes_layout" android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/profile_issuer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/issuer"
                    android:textSize="12sp"
                    android:textStyle="bold"  android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/profile_account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profile_issuer"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Account name" />

                <TextView
                    android:id="@+id/profile_copied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profile_issuer"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/copied"
                    android:textSize="10sp"
                    android:visibility="invisible" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/profile_codes_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical" android:layout_toEndOf="@id/layoutImage" android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/profile_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:textColor="?attr/colorCode"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="012 345" />

                <TextView
                    android:id="@+id/next_profile_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:paddingStart="2dp"
                    android:textColor="?attr/colorOnSurfaceDim"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    tools:text="412 643" />

            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/buttonRefresh"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_outline_refresh_24"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/drag_handle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_outline_menu_24"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

    <app.orious.authenticator.ui.views.TotpProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="5000"
        android:progressDrawable="@drawable/progress_horizontal" />

</com.google.android.material.card.MaterialCardView>
